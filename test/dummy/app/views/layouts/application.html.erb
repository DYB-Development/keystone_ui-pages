<!DOCTYPE html>
<html <%= keystone_theme_attributes %>>
  <head>
    <title><%= content_for(:title) || "Dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      window.pageEvents = []
      window.pageErrors = []
      window.addEventListener("unhandledrejection", (event) => window.pageErrors.push(String(event.reason)))
      for (const name of ["keystone-ui-pages:view", "keystone-ui-pages:click"]) {
        document.addEventListener(name, (event) => window.pageEvents.push({ name, ...event.detail }))
      }
    </script>
    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind" %>
  </head>

  <body data-host-layout>
    <% if Rails.env.development? %>
      <nav class="mx-auto flex max-w-5xl gap-4 px-4 pt-4 text-sm" data-demo-visitor>
        <span>Acting as:</span>
        <% { "visitor" => "Anonymous visitor", "signed_in_client" => "Signed-in client", "purchased_client" => "Client who purchased" }.each do |visitor, label| %>
          <%= link_to label, main_app.demo_visitor_path(visitor), class: (session[:demo_visitor] || "visitor") == visitor ? "font-semibold underline" : "hover:underline" %>
        <% end %>
      </nav>
    <% end %>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
