<% content_for :head do %>
  <%= javascript_include_tag "keystone_ui/react", defer: true %>
  <%= javascript_include_tag "keystone_ui_pages/editor", defer: true %>
<% end %>

<% sequence_screen = { back_url: @sequence.back_url, sequence: sequence_props(@sequence, @page, place: params[:place], key: params[:key]) } %>
<div data-page-builder>
  <% if @page %>
    <%= react_ui("keystone_ui_pages/editor", editor_props(@page).merge(name: @page.name, publish_url: publish_manage_page_path(@page), unpublish_url: (unpublish_manage_page_path(@page) if @page.live_version)).merge(sequence_screen)) %>
  <% else %>
    <%= react_ui("keystone_ui_pages/editor", sequence_screen) %>
  <% end %>
</div>
