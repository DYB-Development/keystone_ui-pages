<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: @archived ? "Archived pages" : "Pages") %>

  <p class="mb-4 text-sm">
    <%= @archived ? link_to("Show current pages", manage_pages_path) : link_to("Show archived", manage_pages_path(archived: 1)) %>
  </p>

  <div class="ks-table overflow-x-auto">
    <table class="relative min-w-full divide-y divide-gray-300 dark:divide-white/15">
      <thead class="ks-table-head">
        <tr>
          <th class="ks-table-header ks-table-header-first text-left text-sm">Name</th>
          <th class="ks-table-header ks-table-header-middle text-left text-sm">Status</th>
          <th class="ks-table-header ks-table-header-middle text-left text-sm">Last published</th>
          <% if KeystoneUi::Pages.places.any? %>
            <th class="ks-table-header ks-table-header-middle text-left text-sm">Place</th>
          <% end %>
          <% if KeystoneUi::Pages.access_exceptions.any? %>
            <th class="ks-table-header ks-table-header-middle text-left text-sm">Access exception</th>
          <% end %>
          <th class="ks-table-header ks-table-header-last text-right text-sm"><span class="sr-only">Open</span></th>
        </tr>
      </thead>
      <tbody class="ks-table-body">
        <% @pages.each do |page| %>
          <% live = page.live_version %>
          <tr data-page="<%= page.slug %>">
            <td class="ks-table-cell-first text-sm whitespace-nowrap"><%= page.name %></td>
            <td class="ks-table-cell-middle text-sm whitespace-nowrap"><%= ui_badge(label: live ? "Published" : "Draft", variant: live ? :success : :neutral) %></td>
            <td class="ks-table-cell-middle text-sm whitespace-nowrap"><%= live&.created_at&.to_date&.to_fs(:long) %></td>
            <% if KeystoneUi::Pages.places.any? %>
              <td data-access class="ks-table-cell-middle text-sm whitespace-nowrap"><%= KeystoneUi::Pages.places[page.place] %></td>
            <% end %>
            <% if KeystoneUi::Pages.access_exceptions.any? %>
              <td data-access class="ks-table-cell-middle text-sm whitespace-nowrap"><%= KeystoneUi::Pages.access_exceptions[page.access_exception] %></td>
            <% end %>
            <td class="ks-table-cell-middle text-sm whitespace-nowrap text-right">
              <%= link_to "Edit", manage_page_path(page) %>
              <% if live %>
                <%= link_to "View live", manage_page_live_path(page), class: "ml-4" %>
                <% if @printable %>
                  <%= link_to "PDF", manage_page_pdf_path(page), class: "ml-4" %>
                <% end %>
              <% end %>
              <% if page.archived_at %>
                <div class="ml-4 inline-block">
                  <%= ui_form(action: restore_manage_page_path(page), method: :post) do %>
                    <%= ui_button(label: "Restore", type: :submit, variant: :secondary, size: :sm) %>
                  <% end %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
