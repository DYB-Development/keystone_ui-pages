<% content_for :head do %>
  <%= javascript_include_tag "keystone_ui/react", defer: true %>
  <%= javascript_include_tag "keystone_ui_pages/editor", defer: true %>
<% end %>

<div data-page-builder>
  <%= ui_page_header(title: @page.name) %>

  <%= ui_form(action: publish_manage_page_path(@page), method: :post) do %>
    <%= ui_button(label: "Publish", type: :submit) %>
  <% end %>

  <%= react_ui("keystone_ui_pages/editor", editor_props(@page)) %>
</div>
