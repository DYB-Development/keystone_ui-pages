<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "New page") %>

  <%= ui_form(action: manage_pages_path, method: :post) do %>
    <%= hidden_field_tag "page[place]", @place if @place %>

    <label class="ks-label mb-1">Name</label>
    <%= ui_input(name: "page[name]", placeholder: @default_name) %>

    <% if KeystoneUi::Pages.slugged?(@place) %>
      <label class="ks-label mb-1">URL slug</label>
      <%= ui_input(name: "page[slug]", placeholder: "e.g. pricing") %>
    <% end %>

    <% if !@place && KeystoneUi::Pages.places.any? %>
      <label class="ks-label mb-1">Place</label>
      <%= ui_select(name: "page[place]", options: KeystoneUi::Pages.places.invert.to_a) %>
    <% end %>

    <%= ui_button(label: "Create", type: :submit) %>
  <% end %>
<% end %>
