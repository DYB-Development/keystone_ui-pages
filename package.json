{
  "name": "keystone_ui-pages",
  "version": "0.1.0",
  "description": "The page editor script for the keystone_ui-pages Rails engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app/javascript/keystone_ui_pages/editor.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --alias:react=keystone_ui-react/src/react_on_page.js --alias:react-dom/client=keystone_ui-react/src/react_dom_on_page.js --alias:react-dom=keystone_ui-react/src/react_dom_on_page.js --alias:react/jsx-runtime=keystone_ui-react/src/jsx_runtime_on_page.js --outdir=app/assets/builds/keystone_ui_pages"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/react": "0.52.0",
    "keystone_ui-react": "https://github.com/DYB-Development/keystone_ui-react/archive/refs/tags/v0.1.3.tar.gz",
    "lexical": "0.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT"
}
